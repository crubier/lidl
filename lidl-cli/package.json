{
  "name": "lidl-cli",
  "version": "0.9.0",
  "description": "Lidl Command Line Interface",
  "type": "module",
  "dependencies": {
    "lidl-core": "file:../lidl-core"
  },
  "scripts": {
    "lidl": "bun src/index.ts",
