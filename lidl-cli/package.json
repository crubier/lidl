    "url": "https://vlecrubi@git.onera.fr/LIDL"
  },
  "keywords": [
    "Lidl"
  ],
  "author": "Vincent Lecrubier <vincent.lecrubier@gmail.com> (http://www.vincentlecrubier.fr/)",
  "license": "MIT",
  "bin": {
    "lidl": "src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10"
  }
}
